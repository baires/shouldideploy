{
  "name": "shouldideploy",
  "description": "Should I Deploy today?",
  "author": "Alexis Sagrbossa",
  "license": "WTFPL",
  "version": "2.0.1",
  "repository": "https://github.com/baires/shouldideploy/",
  "scripts": {
    "precommit": "NODE_ENV=production lint-staged",
    "dev": "next -p 3000",
    "build": "next build",
    "start": "next start",
    "test": "jest",
    "lint": "eslint pages component helpers tests --fix",
    "format": "prettier-eslint --write $PWD/'**/*.js'"
  },
  "dependencies": {
    "@vercel/og": "^1.0.2",
    "next": "^16.3.4",
    "prettier-eslint-cli": "^9.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "26.5.0",
    "@types/react": "19.2.18",
    "babel-eslint": "^10.1.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jest": "^30.5.1",
    "lint-staged": "^17.5.1",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "6.0.2",
    "typescript-eslint": "^8.70.0"
  },
  "overrides": {
    "typescript": "6.0.2"
  },
  "husky": {
    "hooks": {
      "pre-commit": "npm run format && npm run lint"
    }
  },
  "engines": {
    "node": "22.x"
  }
}
